# ==========================================
# Email Notification & SMTP Configuration
# ==========================================

# SMTP Server Host (e.g. smtp.gmail.com, smtp-mail.outlook.com, smtp.hostinger.com)
SMTP_HOST=smtp.gmail.com

# SMTP Server Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Set to true for port 465, false for port 587
SMTP_SECURE=false

# Your email address (e.g. your-email@gmail.com)
SMTP_USER=

# Your email App Password or SMTP password
# (For Gmail: generate a 16-character App Password at https://myaccount.google.com/apppasswords)
SMTP_PASS=

# Sender Name and Email displayed to recipient
MAIL_FROM="The Yenepoya World" <admissions@yenepoyaworldschool.com>

# Default recipient email address for inquiries & notifications
NOTIFICATION_TO=yenopoyaworld@gmail.com
